  "share_definition": "weighted share of the households in the cell that have food data; households whose value_month_ columns are all missing (NO_FOOD_DATA) are counted in no_food_data_households and excluded from numerators and denominators (ruling R33)",
  "segment_rules": {
    "zero_recall": "no chicken, mutton, beef, fish, pork or eggs with positive quantity or value in the recall window; a missing group counts as no purchase, unless every value_month_ column is missing (NO_FOOD_DATA)",
    "vegetarian": "India only: NFHS5_CALIBRATED within calibrated state, religion and caste cells, otherwise zero-recall households; Pakistan has no vegetarian segment",
    "meat_eater": "every household that is not vegetarian",
    "addressable": "urban meat eater with value_month_packaged above 0; the packaged condition is dropped for a country whose packaged value is missing for every household",
    "addressable_vegetarian": "India only: urban vegetarian with value_month_packaged above 0, same rule R6"
  },
  "zero_recall_caveat": "the recall window is 7 days, so a household that eats meat less often than weekly counts as zero-recall; ZERO_RECALL_DIAGNOSTIC vegetarian shares therefore sit above the share that never eats meat",
