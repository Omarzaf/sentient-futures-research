  "band_methods": {
    "gdp_per_capita_usd_2025": {
      "source": "IMF World Economic Outlook, October 2026 (DataMapper API): NGDPDPC, NGDP_RPCH, LP",
      "mid": "NGDPDPC 2025 grown at IMF real per capita growth (1 + NGDP_RPCH/100) / (LP_t / LP_t-1) - 1; 2032 to 2035 hold the 2031 rate; real exchange rate fixed at 2025",
      "low_high": "mid * exp(-/+ 1.2816 * sigma * sqrt(years after 2025)); sigma = standard deviation of realised annual log real per capita growth 2000 to 2019",
      "sigma": {
        "India": 0.01749033948136603,
        "Pakistan": 0.016199920142043037
      },
      "extended_years": [
        2032,
        2033,
        2034,
        2035
      ],
      "note": "IMF reports India on a fiscal-year basis"
    },
    "population": {
      "source": "UN World Population Prospects 2024, TPopulation1July",
      "bands": {
        "low": "Lower 80 PI",
        "mid": "Medium",
        "high": "Upper 80 PI"
      },
      "note": "IMF LP (used only for per capita growth) differs from WPP; Pakistan 2025: IMF 240.49 million, WPP 255.22 million"
    },
    "urban_share": {
      "source": "UN World Urbanization Prospects 2018, F21 annual percentage urban (national definitions)",
      "bands": "low = mid = high: WUP 2018 publishes one projection; no band",
      "not_used": "WUP 2025 F02 (Degree of Urbanisation, cities and towns) uses a different urban definition from the HCES and HIES sector codes"
    }
  },
